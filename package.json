{
  "name": "cabanas-manuara-monorepo",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@cabanas/web",
    "dev:admin": "npm run dev --workspace=@cabanas/admin",
    "build:web": "npm run build --workspace=@cabanas/web",
    "build:admin": "npm run build --workspace=@cabanas/admin",
    "build": "npm run build:web && npm run build:admin",
    "lint:web": "npm run lint --workspace=@cabanas/web",
    "lint:admin": "npm run lint --workspace=@cabanas/admin",
    "lint": "npm run lint:web && npm run lint:admin",
    "preview:web": "npm run preview --workspace=@cabanas/web",
    "preview:admin": "npm run preview --workspace=@cabanas/admin"
  }
}
