# Variables de Entorno - Panel Administrador (Cabañas Manuara)
# Copia este archivo a apps/admin/.env para desarrollo local
# En Vercel/Netlify, configúralas en Settings -> Environment Variables

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# URL del Sitio Web Público desplegado (incluir siempre https:// en producción)
# Ejemplo producción: https://www.manuaracabanas.cl
VITE_PUBLIC_SITE_URL=http://localhost:5173
